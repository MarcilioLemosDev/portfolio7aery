---
import { paradas } from '../dados/planetas';
---

<div class="hud-progress" data-hud-progress></div>
<div class="hud-top">
  <span class="mono">Marcílio Lemos</span>
  <span class="mono">Profundidade <span data-hud-pct>0</span>%</span>
</div>
<nav class="hud-stops" aria-label="Navegação do sistema solar">
  {
    paradas.map((parada) => (
      <button
        type="button"
        class="hud-stop"
        data-stop={parada.id}
        aria-label={`Ir para ${parada.id}`}
      >
        <span class="mono">{parada.label}</span>
        <i />
      </button>
    ))
  }
</nav>
