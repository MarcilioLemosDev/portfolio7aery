---
import { paradas, planetas } from '../dados/planetas';

// Mapa id → {planeta, índice}, pra saber qual parada vira órbita e a
// velocidade relativa de giro (decrescente: Mercúrio mais rápido, Netuno
// mais lento — mesma lógica de planetas reais, sem levar a extremos).
const planetaPorId = new Map(
  planetas.map((planeta, indice) => [planeta.id, { planeta, indice }])
);

const idiomas = [
  { code: 'pt', href: '/', label: 'PT-BR' },
  { code: 'en', href: '/en/', label: 'EN' },
  { code: 'fr', href: '/fr/', label: 'FR' },
];
const atual = idiomas.find((i) => i.code === (Astro.currentLocale ?? 'pt')) ?? idiomas[0];
---

<div class="hud-progress" data-hud-progress></div>
<header class="hud-top">
  <button type="button" class="mono hud-brand" data-stop="sol" aria-label="Voltar ao topo">
    <img src="/logo.svg" alt="" width="12" height="12" /> 7Aery
  </button>
  <nav class="hud-nav" aria-label="Seções do site">
    <button type="button" class="mono hud-link" data-stop="orbitas">Projetos</button>
    <button type="button" class="mono hud-link" data-stop="rede">Time</button>
    <span class="mono hud-depth">Profundidade <span data-hud-pct>0</span>%</span>
    <div class="hud-lang" data-lang-switch>
      <button
        type="button"
        class="mono hud-lang-btn"
        data-lang-btn
        aria-haspopup="true"
        aria-expanded="false"
      >
        <span>{atual.label}</span>
        <svg viewBox="0 0 10 6" aria-hidden="true">
          <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" />
        </svg>
      </button>
      <ul class="hud-lang-menu mono" data-lang-menu hidden>
        {
          idiomas.map((i) => (
            <li>
              <a href={i.href} hreflang={i.code} data-active={i.code === atual.code}>
                {i.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <button type="button" class="mono hud-cta" data-aplicar="projeto">Aplicar</button>
  </nav>
</header>
<nav class="hud-stops" aria-label="Paradas da travessia">
  {
    paradas.map((parada) => {
      const info = planetaPorId.get(parada.id);
      if (!info) {
        return (
          <button
            type="button"
            class="hud-stop"
            data-stop={parada.id}
            aria-label={`Ir para ${parada.label}`}
          >
            <span class="mono">{parada.label}</span>
            <i />
          </button>
        );
      }
      const velocidade = (1.6 - info.indice * 0.18).toFixed(2);
      return (
        <button
          type="button"
          class="hud-stop hud-stop-orbit"
          data-stop={parada.id}
          aria-label={`Ir para ${parada.label}`}
        >
          <span class="mono">{parada.label}</span>
          <span class="rail-orbit">
            <span class="rail-pivot" data-rail-pivot data-speed={velocidade}>
              <img
                class="rail-planet"
                src={info.planeta.img}
                alt=""
                width="18"
                height="18"
                loading="lazy"
              />
            </span>
          </span>
        </button>
      );
    })
  }
</nav>
