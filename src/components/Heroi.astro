---
// Herói: promessa de categoria (soluções em tecnologia sob medida para
// negócios digitais e omnichannel) + captação imediata.
---

<section id="sol" class="hero">
  <div class="hero-sun">
    <img
      src="/space/sol.jpg"
      alt="Composição de um ano de imagens do Sol pelo Solar Dynamics Observatory (NASA/SDO)"
      width="1024"
      height="1024"
      fetchpriority="high"
    />
  </div>
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="hero-copy">
    <img class="hero-logo" src="/logo.svg" alt="" width="200" height="200" />
    <p class="mono eyebrow">Acompanhe o setor que mais cresce no mundo</p>
    <h1>
      Serviços em <em>e-commerce</em> sob medida para o seu negócio 100%
      digital.
    </h1>
    <p class="hero-tag">
      Seu negócio no digital com custos até 90% abaixo do mercado tradicional.
      Interfaces responsivas que direcionam o lead para a zona quente.
    </p>
    <button type="button" class="hero-cta" data-stop="orbitas">
      Entrar na fila de espera
    </button>
  </div>
  <p class="mono hero-hint">Role para ver como funciona</p>
</section>
