---
// Herói: a Terra ao fundo (combina com o ciano da logo), sob o mesmo véu que
// o Sol tinha. Promessa de categoria + captação imediata. A órbita ambiente
// (planetas vindo dos lados, giro constante) fica entre o scrim e o véu.
import Orbita from './Orbita.astro';
---

<section id="sol" class="hero">
  <div class="hero-sun">
    <img
      src="/space/terra.jpg"
      alt="A Terra vista pela tripulação da Apollo 17, a Blue Marble (NASA)"
      width="1024"
      height="1024"
      fetchpriority="high"
    />
  </div>
  <div class="hero-scrim" aria-hidden="true"></div>
  <Orbita />
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="hero-copy">
    <img class="hero-logo" src="/logo.svg" alt="" width="200" height="200" />
    <p class="hero-kicker">O futuro é Tech</p>
    <p class="mono eyebrow">Acompanhe o setor que mais cresce no mundo</p>
    <h1>
      Ambiente <em>100% digital</em> sob medida para o seu negócio.
    </h1>
    <p class="hero-tag">
      Traga seus serviços para o digital com custos até 90% abaixo do
      mercado físico tradicional.
    </p>
    <button type="button" class="hero-cta" data-quiz>
      Descobrir o diagnóstico do meu negócio
    </button>
    <p class="hero-caption">
      Transforme seu negócio com interfaces responsivas e inovadoras que
      direcionam seus clientes para a zona quente de fechamento.
    </p>
    <button type="button" class="hero-direto mono" data-aplicar="projeto">
      Prefiro falar direto
    </button>
  </div>
</section>
