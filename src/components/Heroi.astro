---
// Herói: promessa de categoria (ambiente 100% digital sob medida) +
// captação imediata.
---

<section id="sol" class="hero">
  <div class="hero-sun">
    <img
      src="/space/sol.jpg"
      alt="Composição de um ano de imagens do Sol pelo Solar Dynamics Observatory (NASA/SDO)"
      width="1024"
      height="1024"
      fetchpriority="high"
    />
  </div>
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="hero-copy">
    <img class="hero-logo" src="/logo.svg" alt="" width="200" height="200" />
    <p class="hero-kicker">O futuro é Tech</p>
    <p class="mono eyebrow">Acompanhe o setor que mais cresce no mundo</p>
    <h1>
      Ambiente <em>100% digital</em> sob medida para o seu negócio.
    </h1>
    <p class="hero-tag">
      Traga seus serviços para o digital com custos até 90% abaixo do
      mercado físico tradicional.
    </p>
    <button type="button" class="hero-cta" data-stop="orbitas">
      Entrar na fila de espera
    </button>
    <p class="hero-caption">
      Transforme seu negócio com interfaces responsivas e inovadoras que
      direcionam seus clientes para a zona quente de fechamento.
    </p>
  </div>
  <p class="mono hero-hint">Role para ver como funciona</p>
</section>
