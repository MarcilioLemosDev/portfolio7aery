---
// Herói: a marca 7Aery sob o primeiro véu (pinned + scrub no index).
// Captação presente desde o início: resumo direto + aplicação.
---

<section id="sol" class="hero">
  <div class="hero-sun">
    <img
      src="/space/sol.jpg"
      alt="Composição de um ano de imagens do Sol pelo Solar Dynamics Observatory (NASA/SDO)"
      width="1024"
      height="1024"
      fetchpriority="high"
    />
  </div>
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="hero-copy">
    <img class="hero-logo" src="/logo.svg" alt="" width="200" height="200" />
    <h1>7Aery</h1>
    <p class="mono eyebrow">Software · sob aplicação · Brasil</p>
    <p class="hero-tag">
      Sites, apps e produtos digitais. Sem pacotes nem preços de prateleira:
      cada projeto passa por aplicação e entra numa fila de espera.
    </p>
    <button type="button" class="hero-cta" data-aplicar="projeto">
      Aplicar para um projeto
    </button>
  </div>
  <p class="mono hero-hint">Ou role: cada véu revela uma camada</p>
</section>
