---
const tiers = [
  {
    tier: '01',
    name: 'Site',
    desc: 'A vitrine essencial. Posiciona o negócio, carrega num instante e converte visita em lead.',
  },
  {
    tier: '02',
    name: 'Site + App',
    desc: 'Vitrine e loja. A experiência completa no navegador e no bolso do cliente, com a qualificação embutida.',
  },
  {
    tier: '03',
    name: 'Site + App + Instagram',
    desc: 'O funil inteiro: vitrine, qualificação e checkout — do primeiro scroll ao WhatsApp do seu time.',
  },
];
---

<section id="orbitas" class="orbitas">
  <div class="orbitas-head">
    <p class="mono">Projetos · somente por aplicação</p>
    <h2>Três escopos, um processo.</h2>
    <p class="orbitas-lead">
      Agenda deliberadamente limitada: o projeto entra na fila de espera, é
      avaliado e, havendo encaixe, o convite chega por e-mail.
    </p>
    <p class="mono processo">Entender → versões livres → deploy</p>
  </div>
  <div class="tiers">
    {
      tiers.map((t) => (
        <article class="tier">
          <p class="mono">{t.tier}</p>
          <h3>{t.name}</h3>
          <p>{t.desc}</p>
          <button
            type="button"
            class="tier-cta"
            data-aplicar="projeto"
            data-preset={t.name}
          >
            Aplicar à fila de espera
          </button>
        </article>
      ))
    }
  </div>
  <p class="mono scarcity">
    Sem preços públicos · vagas limitadas por trimestre
  </p>
</section>
