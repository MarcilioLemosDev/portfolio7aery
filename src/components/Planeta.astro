---
import type { Planeta } from '../dados/planetas';

interface Props {
  planeta: Planeta;
  indice: number;
}

const { planeta, indice } = Astro.props;
const numero = String(indice + 1).padStart(2, '0');
---

<section id={planeta.id} class="planet" style={`--glow:${planeta.glow}`}>
  <div class={planeta.shape === 'wide' ? 'orb wide' : 'orb'}>
    <img src={planeta.img} alt={planeta.alt} loading="lazy" decoding="async" />
  </div>
  <div class="p-copy">
    <p class="mono p-eyebrow">{numero} · {planeta.tema}</p>
    <h2>{planeta.titulo}</h2>
    <p class="p-frase">{planeta.frase}</p>
  </div>
</section>
