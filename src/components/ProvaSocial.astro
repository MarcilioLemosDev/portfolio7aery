---
// Prova social imediata (posição firstbase: logo após o herói) — último
// projeto em produção, com link verificável.
---

<section id="prova" class="prova">
  <p class="mono prova-eyebrow">Último projeto entregue</p>
  <a
    class="prova-cliente"
    href="https://mi6consorcio.com.br"
    target="_blank"
    rel="noopener"
  >
    <img
      src="/logo-mi6.png"
      alt="MI6 Consórcio Nacional"
      width="219"
      height="47"
      loading="lazy"
      decoding="async"
    />
    <span class="mono">mi6consorcio.com.br ↗</span>
  </a>
  <p class="prova-frase">
    Da vitrine ao botão de WhatsApp: funil completo em produção.
  </p>
</section>
